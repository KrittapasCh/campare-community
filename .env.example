# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase Dashboard
# Project Settings -> Data API / API Keys

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ใช้เฉพาะฝั่ง server (seed script / admin task) — ห้าม commit และห้ามขึ้นต้นด้วย NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# โหมดเดโม: อนุญาตให้ซื้อประกาศของตัวเองได้ (ปกติระบบห้าม)
# ใช้ตอนนำเสนอที่มี user บัญชีเดียว — ตั้งเป็น false หรือลบทิ้งเมื่อส่งงานจริง
ALLOW_SELF_PURCHASE=true
